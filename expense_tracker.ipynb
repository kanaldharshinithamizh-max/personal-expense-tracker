   "source": [
    "print(\"PERSONAL EXPENSE TRACKER\")\n",
    "\n",
    "expenses = []\n",
    "\n",
    "n = int(input(\"Enter number of expenses: \"))\n",
    "\n",
    "for i in range(n):\n",
    "    amount = float(input(\"Enter expense amount: \"))\n",
    "    expenses.append(amount)\n",
    "\n",
    "total = sum(expenses)\n",
    "\n",
    "print(\"\\nTotal Expense =\", total)"
   ]
